  "renderedMainHtml": "\n    <p style=\"color:#4B5563; margin-bottom:12px;\">\n      Read daily news updates, official software changelogs, security advisories, and feature announcements from the ApexMobile engineering team.\n    </p>\n    <div class=\"news-filter-bar\">\n      <button type=\"button\" class=\"news-filter-btn active\" data-news-cat=\"ALL\">\n        All News (3)\n      </button>\n    \n      <button type=\"button\" class=\"news-filter-btn \" data-news-cat=\"Release Update\">\n        Release Update\n      </button>\n    \n      <button type=\"button\" class=\"news-filter-btn \" data-news-cat=\"Security Advisory\">\n        Security Advisory\n      </button>\n    \n      <button type=\"button\" class=\"news-filter-btn \" data-news-cat=\"Infrastructure News\">\n        Infrastructure News\n      </button>\n    </div>\n    <div id=\"news-hub-articles-container\">\n              <article class=\"news-item-block\">\n                <a href=\"/news/apexmobile-v4-8-2-release-notes\" data-spa-link class=\"news-card-media-link\">\n                  <img src=\"/assets/hero-banner.svg\" alt=\"ApexMobile v4.8.2 Release Benchmark Overview\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\" class=\"news-card-cover-img\" />\n                </a>\n                <div class=\"news-meta-line\">\n                  <span class=\"news-category-tag\">Release Update</span>\n                  <span class=\"news-featured-tag\">★ Featured</span>\n                  <span>November 4, 2026</span>\n                  <span>· By ApexMobile Core Engineering</span>\n                  <span>· 2 min read</span>\n                </div>\n                <h3 style=\"margin-top:6px; border-bottom:none; padding-bottom:0;\">\n                  <a href=\"/news/apexmobile-v4-8-2-release-notes\" data-spa-link class=\"news-title-link\">ApexMobile v4.8.2 Released with 45% Faster Cold-Start Engine</a>\n                </h3>\n                <p style=\"margin-bottom:10px;\">Version 4.8.2 introduces our new lightweight memory allocator, reducing app launch time to under 180ms across Android 9+ and iOS 15+ devices.</p>\n                <a href=\"/news/apexmobile-v4-8-2-release-notes\" data-spa-link class=\"news-read-more\">Read Full News Article →</a>\n              </article>\n            \n\n              <article class=\"news-item-block\">\n                \n                <div class=\"news-meta-line\">\n                  <span class=\"news-category-tag\">Security Advisory</span>\n                  \n                  <span>October 28, 2026</span>\n                  <span>· By Security &amp; Compliance Desk</span>\n                  <span>· 2 min read</span>\n                </div>\n                <h3 style=\"margin-top:6px; border-bottom:none; padding-bottom:0;\">\n                  <a href=\"/news/security-audit-sha256-verification-report\" data-spa-link class=\"news-title-link\">Security Audit Complete: 100% Clean SHA-256 Verification Report</a>\n                </h3>\n                <p style=\"margin-bottom:10px;\">Our quarterly independent security audit confirmed zero vulnerabilities and 0/72 clean multi-engine verification across all official distribution mirrors.</p>\n                <a href=\"/news/security-audit-sha256-verification-report\" data-spa-link class=\"news-read-more\">Read Full News Article →</a>\n              </article>\n            \n\n              <article class=\"news-item-block\">\n                \n                <div class=\"news-meta-line\">\n                  <span class=\"news-category-tag\">Infrastructure News</span>\n                  \n                  <span>October 21, 2026</span>\n                  <span>· By Network Operations Team</span>\n                  <span>· 3 min read</span>\n                </div>\n                <h3 style=\"margin-top:6px; border-bottom:none; padding-bottom:0;\">\n                  <a href=\"/news/global-edge-cdn-upgrade-low-latency-nodes\" data-spa-link class=\"news-title-link\">Global Edge CDN Upgrade: 14 New Low-Latency Download Nodes Live</a>\n                </h3>\n                <p style=\"margin-bottom:10px;\">We have expanded our Cloudflare &amp; multi-region edge mirror network across Asia-Pacific, Europe, and North America for instant package delivery.</p>\n                <a href=\"/news/global-edge-cdn-upgrade-low-latency-nodes\" data-spa-link class=\"news-read-more\">Read Full News Article →</a>\n              </article>\n            </div>\n  ",
