# ============================================================================
# MASTER CMS STUDIO — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Works identically on Node.js (.env) and Cloudflare Pages / Vercel / Cloud Run
# Full hosting documentation (Secret vs Non-Secret): see ENV_VARIABLES.md
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION & SESSION SECURITY [ALL SECRETS - NEVER EXPOSE CLIENT-SIDE]
# ----------------------------------------------------------------------------
# Set ADMIN_EMAIL + ADMIN_PASSWORD (min 8 chars) OR ADMIN_API_KEY (min 16 chars),
# PLUS ADMIN_SESSION_SECRET (min 16-32 random chars). Admin stays locked (HTTP 503) until set.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
# Optional Server API Key login tab (min 16 random chars):
# ADMIN_API_KEY=""

# ----------------------------------------------------------------------------
# 2. v12 7-GATE SECURITY GATEWAY & AES-256-GCM LINK VAULT
# ----------------------------------------------------------------------------
# [SECRET] 32+ char key for AES-256-GCM download encryption & HMAC signing:
VAULT_ENCRYPTION_SECRET=""
# [NON-SECRET] Cloudflare Turnstile public Site Key (0x4...):
TURNSTILE_SITE_KEY=""
# [SECRET] Cloudflare Turnstile private Secret Key (0x4...):
TURNSTILE_SECRET_KEY=""
# [NON-SECRET] Optional policy: universal_human (default) or strict_mobile_only
# SECURITY_DEVICE_POLICY="universal_human"
# [SECRET] Optional distributed Redis nonce burn & rate-limit store (Upstash REST):
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ----------------------------------------------------------------------------
# 3. LIVE FIREBASE CLOUD FIRESTORE (ADMIN STUDIO ONLY) [NON-SECRET WEB CONFIG]
# ----------------------------------------------------------------------------
# Public website is 100% static HTML/JSON and NEVER touches Firebase.
# Can be added here OR pasted in Admin Studio -> Workspace 8 -> Card 5.
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_DATABASE_ID="(default)"
# Optional single-line JSON alternative:
# FIREBASE_CONFIG_JSON=""

# ----------------------------------------------------------------------------
# 4. GITHUB STATIC PUBLISHER (ADMIN -> PUBLIC SYNC)
# ----------------------------------------------------------------------------
# [SECRET] Fine-Grained PAT with Contents: Read and write:
GITHUB_FINE_GRAINED_TOKEN=""
# [NON-SECRET] Target repository details:
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
GITHUB_BRANCH="main"

# ----------------------------------------------------------------------------
# 5. OPTIONAL RUNTIME & INITIAL BRAND SEEDS [NON-SECRET]
# ----------------------------------------------------------------------------
# PORT="3000"
# NODE_ENV="production"
# TRUST_PROXY="false"
# PUBLIC_DOMAIN=""
# ALLOWED_HOSTNAMES=""
# SITE_BRAND_NAME=""
# SITE_CANONICAL_URL=""
# SITE_CONTACT_EMAIL=""
