# ============================================================================
# MASTER CMS STUDIO — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Works identically on Node.js (.env) and Cloudflare Pages (Settings -> Environment variables)
# See ENV_VARIABLES.md for details.
# ============================================================================

# 1. Admin Studio Login & Session Security (Required in Production)
ADMIN_EMAIL="admin@domain.com"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="replace-with-a-random-32-char-session-signing-secret"
# Optional alternative login key for Server API Key tab:
# ADMIN_API_KEY=""

# 2. v12 7-Gate Security Gateway & AES-256-GCM Link Vault
# Used to encrypt download links (v2.<iv>.<cipher>) and sign nonces:
VAULT_ENCRYPTION_SECRET="replace-with-a-random-32-char-aes-vault-secret"
# Cloudflare Turnstile Keys (Leave blank for local dev test key; set real keys in production):
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 3. Live Firebase Cloud Persistence for Admin Studio (Optional)
# Public website is 100% static compiled HTML/JSON and NEVER uses Firebase.
# You can configure these in .env/Cloudflare OR paste the snippet in Admin Studio -> Workspace 8.
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_DATABASE_ID="(default)"
# Optional single-line JSON alternative:
# FIREBASE_CONFIG_JSON=""

# 4. Optional GitHub Fine-Grained Token Static Publisher Defaults
# (Also editable directly inside Admin Studio -> Workspace 8)
GITHUB_FINE_GRAINED_TOKEN=""
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
GITHUB_BRANCH="main"
