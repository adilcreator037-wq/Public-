# 1. Admin Studio Login & Session Security (Required)
ADMIN_EMAIL="admin@domain.com"
ADMIN_PASSWORD="admin123"
ADMIN_SESSION_SECRET="apex-master-cms-session-secret-key-2026"

# 2. Live Firebase Cloud Persistence for Admin Studio (Optional)
# Note: Public website is 100% compiled static HTML/JSON and never uses Firebase.
# You can set these here OR paste them directly inside Admin Studio -> Workspace 8.
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
